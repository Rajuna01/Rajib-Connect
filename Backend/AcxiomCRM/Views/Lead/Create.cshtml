
@model AcxiomCRM.ViewModels.LeadViewModel

@{
    ViewData["Title"] = "Create Lead";
}

<div class="container mt-4">

    <h2>Create New Lead</h2>
    <p class="text-muted">Enter the prospective customer's information.</p>

    <div class="card shadow-sm p-4 mt-3">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label asp-for="LeadCode" class="form-label">Lead Code</label>
                    <input asp-for="LeadCode" class="form-control"
                           placeholder="Example: LEAD001" />
                    <span asp-validation-for="LeadCode"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="LeadName" class="form-label">Lead Name</label>
                    <input asp-for="LeadName" class="form-control" />
                    <span asp-validation-for="LeadName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyName" class="form-label">Company Name</label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Source" class="form-label">Lead Source</label>
                    <select asp-for="Source" class="form-select">
                        <option value="Other">Other</option>
                        <option value="Website">Website</option>
                        <option value="Referral">Referral</option>
                        <option value="Social Media">Social Media</option>
                        <option value="Advertisement">Advertisement</option>
                        <option value="Cold Call">Cold Call</option>
                    </select>
                    <span asp-validation-for="Source"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="ExpectedValue" class="form-label">
                        Expected Value (₹)
                    </label>
                    <input asp-for="ExpectedValue"
                           type="number"
                           min="0"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="ExpectedValue"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Priority" class="form-label">Priority</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                    <span asp-validation-for="Priority"
                          class="text-danger"></span>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssignedTo" class="form-label">
                            Assign Sales Executive
                        </label>

                        <select asp-for="AssignedTo"
                                asp-items="Model.SalesExecutives"
                                class="form-select">
                            <option value="">Select Sales Executive</option>
                        </select>

                        <span asp-validation-for="AssignedTo"
                              class="text-danger"></span>
                    </div>
                }

            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    Save Lead
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
