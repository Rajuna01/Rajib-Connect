
@model IEnumerable<AcxiomCRM.ViewModels.LeadListViewModel>

@{
    ViewData["Title"] = "Lead Management";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h2 class="mb-1">Lead Management</h2>
            <p class="text-muted mb-0">
                Manage, track and convert potential customers.
            </p>
        </div>

        <a asp-controller="Lead"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Lead
        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Search Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-controller="Lead"
                  asp-action="Index"
                  method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search lead name, code, company, status or assigned user..." />

                    <button type="submit"
                            class="btn btn-dark">
                        <i class="bi bi-search"></i> Search
                    </button>

                    <a asp-controller="Lead"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Clear
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- Lead Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Lead Records</h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-striped table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Lead Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Source</th>
                            <th>Expected Value</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Created Date</th>
                            <th style="min-width: 210px;">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var lead in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@lead.LeadCode</strong>
                                    </td>

                                    <td>@lead.LeadName</td>

                                    <td>@lead.CompanyName</td>

                                    <td>@lead.Email</td>

                                    <td>@lead.Phone</td>

                                    <td>@lead.Source</td>

                                    <td class="text-nowrap">
                                        ₹@lead.ExpectedValue.ToString("N2")
                                    </td>

                                    <!-- Priority -->
                                    <td>
                                        @if (lead.Priority == "High")
                                        {
                                            <span class="badge bg-danger">
                                                High
                                            </span>
                                        }
                                        else if (lead.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Medium
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Low
                                            </span>
                                        }
                                    </td>

                                    <!-- Lead Status -->
                                    <td>
                                        @switch (lead.Status)
                                        {
                                            case "New":
                                                <span class="badge bg-primary">New</span>
                                                break;

                                            case "Contacted":
                                                <span class="badge bg-info text-dark">Contacted</span>
                                                break;

                                            case "Qualified":
                                                <span class="badge bg-success">Qualified</span>
                                                break;

                                            case "Converted":
                                                <span class="badge bg-dark">Converted</span>
                                                break;

                                            case "Lost":
                                                <span class="badge bg-danger">Lost</span>
                                                break;

                                            case "Unqualified":
                                                <span class="badge bg-secondary">Unqualified</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @lead.Status
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>@lead.AssignedToName</td>

                                    <td class="text-nowrap">
                                        @lead.CreatedDate.ToLocalTime().ToString("dd-MM-yyyy")
                                    </td>

                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex flex-wrap gap-1">

                                            <!-- Edit -->
                                            @if (lead.Status != "Converted")
                                            {
                                                <a asp-controller="Lead"
                                                   asp-action="Edit"
                                                   asp-route-id="@lead.LeadId"
                                                   class="btn btn-sm btn-warning">
                                                    Edit
                                                </a>
                                            }

                                            <!-- Convert Qualified Lead -->
                                            @if (lead.Status == "Qualified")
                                            {
                                                <a asp-controller="Lead"
                                                   asp-action="Convert"
                                                   asp-route-id="@lead.LeadId"
                                                   class="btn btn-sm btn-success">
                                                    Convert
                                                </a>
                                            }

                                            <!-- Delete: Admin and Manager -->
                                            @if (User.IsInRole("Admin") ||
                                                 User.IsInRole("Manager"))
                                            {
                                                <form asp-controller="Lead"
                                                      asp-action="Delete"
                                                      asp-route-id="@lead.LeadId"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to delete this lead?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger">
                                                        Delete
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12"
                                    class="text-center py-4 text-muted">

                                    <h6>No leads found.</h6>

                                    <p class="mb-0">
                                        Add a new lead or modify your search.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Table Footer -->
        <div class="card-footer bg-light">

            <div class="d-flex justify-content-between align-items-center">

                <span class="text-muted">
                    Total leads displayed:
                    <strong>@(Model?.Count() ?? 0)</strong>
                </span>

                <a asp-controller="Lead"
                   asp-action="Create"
                   class="btn btn-sm btn-primary">
                    + Add New Lead
                </a>

            </div>

        </div>

    </div>

</div>
