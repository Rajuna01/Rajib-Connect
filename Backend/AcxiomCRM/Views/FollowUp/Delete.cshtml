
@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Follow-up</h2>
        <p class="text-muted">
            Review the information before deleting this record.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Warning!</strong>
                Are you sure you want to permanently delete this follow-up?
            </div>

            <dl class="row">

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">
                    @Model.FollowUpDate.ToString("dd MMMM yyyy")
                </dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.FollowUpType</dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">
                    @(Model.Customer?.CustomerName ?? "Not linked")
                </dd>

                <dt class="col-sm-3">Lead</dt>
                <dd class="col-sm-9">
                    @(Model.Lead?.LeadName ?? "Not linked")
                </dd>

                <dt class="col-sm-3">Assigned To</dt>
                <dd class="col-sm-9">
                    @(Model.AssignedUser?.FullName ?? "Unassigned")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.FollowUpId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Follow-up
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>
