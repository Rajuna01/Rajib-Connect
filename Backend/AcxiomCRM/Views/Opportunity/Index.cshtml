
@model IEnumerable<AcxiomCRM.ViewModels.OpportunityListViewModel>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Opportunity Management</h2>
            <p class="text-muted">Manage your sales pipeline and opportunities.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Opportunity
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Search opportunity, customer or stage..." />
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white fw-bold">
            Opportunity Records
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Lead</th>
                            <th>Owner</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Weighted Value</th>
                            <th>Stage</th>
                            <th>Status</th>
                            <th>Close Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.OpportunityName</td>
                                <td>@item.CustomerName</td>
                                <td>@item.LeadName</td>
                                <td>@item.AssignedToName</td>
                                <td>@item.Amount.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                <td>@item.Probability%</td>
                                <td>@item.WeightedValue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                <td><span class="badge bg-primary">@item.Stage</span></td>
                                <td>
                                    @if (item.Status == "Won")
                                    {
                                        <span class="badge bg-success">Won</span>
                                    }
                                    else if (item.Status == "Lost")
                                    {
                                        <span class="badge bg-danger">Lost</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Open</span>
                                    }
                                </td>
                                <td>@item.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.OpportunityId"
                                           class="btn btn-sm btn-outline-info">View</a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.OpportunityId"
                                           class="btn btn-sm btn-outline-primary">Edit</a>

                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.OpportunityId"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this opportunity?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">
                                No opportunities found. Create your first opportunity.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
