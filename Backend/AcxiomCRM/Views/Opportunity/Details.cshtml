
@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Opportunity Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Opportunity Details</h2>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.OpportunityId"
               class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">@Model.OpportunityName</h5>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-md-6">
                    <strong>Customer</strong>
                    <p>@(Model.Customer?.CustomerName ?? "Not linked")</p>
                </div>

                <div class="col-md-6">
                    <strong>Lead</strong>
                    <p>@(Model.Lead?.LeadName ?? "Not linked")</p>
                </div>

                <div class="col-md-6">
                    <strong>Amount</strong>
                    <p>@Model.Amount.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</p>
                </div>

                <div class="col-md-6">
                    <strong>Probability</strong>
                    <p>@Model.Probability%</p>
                </div>

                <div class="col-md-6">
                    <strong>Weighted Value</strong>
                    <p>@Model.WeightedValue.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</p>
                </div>

                <div class="col-md-6">
                    <strong>Stage</strong>
                    <p>@Model.Stage</p>
                </div>

                <div class="col-md-6">
                    <strong>Status</strong>
                    <p>@Model.Status</p>
                </div>

                <div class="col-md-6">
                    <strong>Expected Close Date</strong>
                    <p>@Model.ExpectedCloseDate.ToString("dd MMMM yyyy")</p>
                </div>

                <div class="col-md-6">
                    <strong>Source</strong>
                    <p>@Model.Source</p>
                </div>

                <div class="col-md-6">
                    <strong>Assigned User</strong>
                    <p>@(Model.AssignedUser?.FullName ?? "Unassigned")</p>
                </div>

                <div class="col-md-6">
                    <strong>Created Date</strong>
                    <p>@Model.CreatedDate.ToString("dd MMMM yyyy")</p>
                </div>

                <div class="col-12">
                    <strong>Notes</strong>
                    <p>@(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes available." : Model.Notes)</p>
                </div>

            </div>
        </div>
    </div>
</div>
