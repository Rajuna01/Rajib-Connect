
@model AcxiomCRM.ViewModels.ActivityListViewModel

@{
    ViewData["Title"] = "Activity Management";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Activity Management</h2>
            <p class="text-muted mb-0">
                Manage calls, meetings, emails and tasks.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Activity
        </a>
    </div>

    <!-- MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Total Activities</p>
                    <h3 class="fw-bold">@Model.TotalActivities</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Planned</p>
                    <h3 class="fw-bold text-primary">@Model.PlannedCount</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Completed</p>
                    <h3 class="fw-bold text-success">@Model.CompletedCount</h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Cancelled</p>
                    <h3 class="fw-bold text-danger">@Model.CancelledCount</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- SEARCH AND FILTER -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-2">

                    <div class="col-md-4">
                        <input type="text"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search activity, customer or lead..." />
                    </div>

                    <div class="col-md-3">
                        <select name="statusFilter" class="form-select">
                            <option value="">All Statuses</option>

                            @foreach (var status in new[] { "Planned", "Completed", "Cancelled" })
                            {
                                if (Model.StatusFilter == status)
                                {
                                    <option value="@status" selected>@status</option>
                                }
                                else
                                {
                                    <option value="@status">@status</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <select name="typeFilter" class="form-select">
                            <option value="">All Types</option>

                            @foreach (var type in new[] { "Call", "Meeting", "Email", "Task" })
                            {
                                if (Model.TypeFilter == type)
                                {
                                    <option value="@type" selected>@type</option>
                                }
                                else
                                {
                                    <option value="@type">@type</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <!-- ACTIVITY TABLE -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Activity Records</h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Customer / Lead</th>
                            <th>Date</th>
                            <th>Assigned To</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Activities.Any())
                        {
                            @foreach (var item in Model.Activities)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.Subject
                                    </td>

                                    <td>
                                        @switch (item.ActivityType)
                                        {
                                            case "Call":
                                                <span>📞 Call</span>
                                                break;
                                            case "Meeting":
                                                <span>🤝 Meeting</span>
                                                break;
                                            case "Email":
                                                <span>✉️ Email</span>
                                                break;
                                            case "Task":
                                                <span>📝 Task</span>
                                                break;
                                            default:
                                                @item.ActivityType
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @if (item.Customer != null)
                                        {
                                            <div>@item.Customer.CustomerName</div>
                                        }

                                        @if (item.Lead != null)
                                        {
                                            <div class="text-muted small">
                                                Lead: @item.Lead.LeadName
                                            </div>
                                        }

                                        @if (item.Customer == null && item.Lead == null)
                                        {
                                            <span class="text-muted">Not linked</span>
                                        }
                                    </td>

                                    <td>
                                        @item.ActivityDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @(item.AssignedUser?.FullName ?? "Unassigned")
                                    </td>

                                    <td>
                                        @switch (item.Status)
                                        {
                                            case "Planned":
                                                <span class="badge bg-primary">Planned</span>
                                                break;
                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@item.Status</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.ActivityId"
                                               class="btn btn-sm btn-outline-info">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.ActivityId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            @if (item.Status == "Planned")
                                            {
                                                <form asp-action="MarkCompleted"
                                                      asp-route-id="@item.ActivityId"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success">
                                                        Complete
                                                    </button>
                                                </form>

                                                <form asp-action="MarkCancelled"
                                                      asp-route-id="@item.ActivityId"
                                                      method="post">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-warning">
                                                        Cancel
                                                    </button>
                                                </form>
                                            }

                                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@item.ActivityId"
                                                   class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </a>
                                            }

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">
                                    <h6>No activities found.</h6>
                                    <p class="small mb-0">
                                        Create a new activity to get started.
                                    </p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
