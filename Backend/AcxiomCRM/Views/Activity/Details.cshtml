
@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Activity Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <div>
            <h2 class="fw-bold">Activity Details</h2>
            <p class="text-muted mb-0">
                Complete information about this activity.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Activities
        </a>

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">@Model.Subject</h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">
                    <p class="text-muted mb-1">Activity ID</p>
                    <h6>@Model.ActivityId</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Activity Subject</p>
                    <h6>@Model.Subject</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Activity Type</p>
                    <h6>@Model.ActivityType</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Activity Date</p>
                    <h6>@Model.ActivityDate.ToString("dd MMMM yyyy")</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Customer</p>
                    <h6>@(Model.Customer?.CustomerName ?? "Not linked")</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Lead</p>
                    <h6>@(Model.Lead?.LeadName ?? "Not linked")</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Assigned To</p>
                    <h6>@(Model.AssignedUser?.FullName ?? "Unassigned")</h6>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">Status</p>

                    @switch (Model.Status)
                    {
                        case "Planned":
                            <span class="badge bg-primary">Planned</span>
                            break;

                        case "Completed":
                            <span class="badge bg-success">Completed</span>
                            break;

                        case "Cancelled":
                            <span class="badge bg-danger">Cancelled</span>
                            break;

                        default:
                            <span class="badge bg-secondary">@Model.Status</span>
                            break;
                    }
                </div>

                <div class="col-12">
                    <p class="text-muted mb-1">Description</p>

                    <div class="border rounded p-3 bg-light">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            <span class="text-muted">
                                No additional description available.
                            </span>
                        }
                    </div>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.ActivityId"
                   class="btn btn-primary">
                    Edit Activity
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back
                </a>

            </div>

        </div>
    </div>

</div>
