
@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">Delete Activity</h2>
        <p class="text-muted">
            Review the activity information before deleting it.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <strong>Warning!</strong>
                Are you sure you want to permanently delete this activity?
            </div>

            <dl class="row">

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Activity Type</dt>
                <dd class="col-sm-9">@Model.ActivityType</dd>

                <dt class="col-sm-3">Activity Date</dt>
                <dd class="col-sm-9">
                    @Model.ActivityDate.ToString("dd MMMM yyyy")
                </dd>

                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">
                    @(Model.Customer?.CustomerName ?? "Not linked")
                </dd>

                <dt class="col-sm-3">Lead</dt>
                <dd class="col-sm-9">
                    @(Model.Lead?.LeadName ?? "Not linked")
                </dd>

                <dt class="col-sm-3">Assigned To</dt>
                <dd class="col-sm-9">
                    @(Model.AssignedUser?.FullName ?? "Unassigned")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.ActivityId"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">
                    Yes, Delete Activity
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
