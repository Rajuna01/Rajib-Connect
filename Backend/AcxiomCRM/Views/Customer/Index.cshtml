
@model IEnumerable<AcxiomCRM.ViewModels.CustomerListViewModel>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Customer Management</h2>
            <p class="text-muted">
                Manage customer information and assignments.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Customer
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search name, code, email or company..." />

            <button class="btn btn-dark" type="submit">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Location</th>
                    <th>Assigned To</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center">
                            No customers found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.CustomerCode</td>
                            <td>@customer.CustomerName</td>
                            <td>@customer.CompanyName</td>
                            <td>@customer.Email</td>
                            <td>@customer.Phone</td>
                            <td>@customer.City, @customer.State</td>
                            <td>@customer.OwnerName</td>
                            <td>
                                @if (customer.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @customer.Status
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@customer.CustomerId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                @if (User.IsInRole("Admin") ||
                                     User.IsInRole("Manager"))
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@customer.CustomerId"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this customer?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>
